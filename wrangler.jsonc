{
  "name": "oddsrail",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  // The preview hostname served the whole site with canonicals pointing at
  // oddsrail.app, so Google catalogued every page there as "alternate page
  // with proper canonical tag". One public hostname, one set of URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site"
  }
}
