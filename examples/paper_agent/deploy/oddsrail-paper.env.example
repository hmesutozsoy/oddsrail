# /etc/oddsrail-paper.env : paper mode only. No keys belong in this file.
ODDSRAIL_DRY_RUN=1
ODDSRAIL_PAPER=1
ODDSRAIL_PAPER_LEDGER=/var/lib/oddsrail-paper/paper.json
ODDSRAIL_PAPER_BANKROLL=1000
ODDSRAIL_PAPER_JOURNAL=/var/lib/oddsrail-paper/journal
ODDSRAIL_MAX_ORDER_NOTIONAL=20
PAPER_AGENT_MAX_MARKETS=5
PAPER_AGENT_QUOTE_SIZE=5
