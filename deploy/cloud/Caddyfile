# /etc/caddy/Caddyfile
# Caddy terminates TLS (Let's Encrypt, automatic) and proxies to the app.
# Requires: DNS A record for mcp.oddsrail.app -> this server, ports 80/443 open.

mcp.oddsrail.app {
	encode gzip
	reverse_proxy 127.0.0.1:8787
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
