# /etc/oddsrail-cloud.env  (root:root, chmod 600)
# The hosted server holds NO wallet keys. Nothing in this file moves money.

# Public base URL; also the OAuth issuer. Must match the hostname Caddy serves.
ODDSRAIL_CLOUD_URL=https://mcp.oddsrail.app

# Magic-link delivery, either:
#  (a) Resend (https://resend.com; verify the sending domain there first)
#ODDSRAIL_RESEND_API_KEY=re_...
#ODDSRAIL_MAIL_FROM="oddsrail <login@oddsrail.app>"
#  (b) any SMTP server, e.g. Gmail with an app password (2-step verification,
#      then Google Account > Security > App passwords); 500 mails/day
#ODDSRAIL_SMTP_HOST=smtp.gmail.com
#ODDSRAIL_SMTP_PORT=587
#ODDSRAIL_SMTP_USER=you@gmail.com
#ODDSRAIL_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#ODDSRAIL_MAIL_FROM="oddsrail <you@gmail.com>"
# Without either, links are printed to the journal only (journalctl -u oddsrail-cloud).

# Listen address for Caddy to proxy to.
ODDSRAIL_CLOUD_BIND=127.0.0.1
ODDSRAIL_CLOUD_PORT=8787

# Paper trading per account.
ODDSRAIL_PAPER=1
ODDSRAIL_PAPER_BANKROLL=1000
# A per-order cap applies to paper orders too, so an agent cannot "buy" a
# whole book in one call.
ODDSRAIL_MAX_ORDER_NOTIONAL=500
